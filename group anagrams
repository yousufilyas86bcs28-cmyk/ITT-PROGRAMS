class Solution:
    def groupAnagrams(self, strs: List[str]) -> List[List[str]]:
        match_map = {}
        for word in strs:
            sorted_word = "".join(sorted(word))
            if sorted_word not in match_map:
                match_map[sorted_word] = []
            match_map[sorted_word].append(word)
        return list(match_map.values())
