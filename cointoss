t_str = input()
t = int(t_str)

for i in range(t):
    line = input().split()
    a = int(line[0])
    b = int(line[1])
    c = int(line[2])
    d = int(line[3])
    suresh = a
    sundar = b
    if suresh >= sundar:
        sundar = sundar + c
    else:
        suresh = suresh + c
    if suresh >= sundar:
        sundar = sundar + d
    else:
        suresh = suresh + d
    if suresh >= sundar:
        print("N")
    else:
        print("S")
