t=int(input())
for k in range(t):
    x = int(input())
    s = input();
    chandru_points = 0
    nirmal_points = 0
    for char in s:
        if char == 'C':
            chandru_points += 2
        elif char == 'N':
            nirmal_points += 2
        elif char == 'D':
            chandru_points += 1
            nirmal_points += 1
    if chandru_points > nirmal_points:
        print(60 * x)
    elif nirmal_points > chandru_points:
        print(40 * x)
    else:
        print(55 * x)
