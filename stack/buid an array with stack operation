class Solution:
    def buildArray(self, target: list[int], n: int) -> list[str]:
        operations = []
        target_idx = 0
        target_len = len(target)

   
        for num in range(1, n + 1):
          
            if target_idx == target_len:
                break

           
            operations.append("Push")

            
            if num == target[target_idx]:
                target_idx += 1  
            else:
                operations.append("Pop")  

        return operations
